WB_ENVIRONMENT=development
# Comma-separated origins allowed to call the API (the web app's URLs).
WB_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:4173
# Local database. Render sets a Postgres URL here.
WB_DATABASE_URL=sqlite:///./waterbuddy.db
# Web push keys: run `python -m app.vapid` and paste the two values.
WB_VAPID_PUBLIC_KEY=
WB_VAPID_PRIVATE_KEY=
WB_VAPID_SUBJECT=mailto:hello@waterbuddy.example
# Secret for POST /internal/send-due (the reminder scheduler). Leave empty to disable.
WB_CRON_TOKEN=
# Check for due reminders every minute inside this process (handy locally).
WB_SCHEDULER_ENABLED=false
